{
    "name": "WPILib 2026",
    "image": "ghcr.io/athenian-robotics/arc-devcontainer:2026.2.1",
    "customizations": {
        "vscode": {
            "extensions": [
                "/home/vscode/extension-artifacts/vscode-wpilib.vsix",
                "/home/vscode/extension-artifacts/redhat-java.vsix"
            ],
            "settings": {
                "java.import.gradle.java.home": "/home/vscode/wpilib/2026/jdk",
                "java.configuration.runtimes": [
                    {
                        "name": "JavaSE-24",
                        "path": "/home/vscode/wpilib/2026/jdk",
                        "default": true
                    }
                ],
                "terminal.integrated.env.linux": {
                    "JAVA_HOME": "/home/vscode/wpilib/2026/jdk"
                }
            }
        }
    },
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/stuartleeks/dev-container-features/shell-history:0": {}
    }
}
